<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <groupId>net.pinger.disguise</groupId>
    <artifactId>DisguiseAPI</artifactId>
    <version>2.0.0</version>
    <packaging>pom</packaging>
    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <spigot.1.21.11.version>1.21.11-R0.2-SNAPSHOT</spigot.1.21.11.version>
        <spigot.26.3.version>26.3-R0.1-SNAPSHOT</spigot.26.3.version>
        <spigot.version>${spigot.26.3.version}</spigot.version>
        <spigot.classifier></spigot.classifier>
        <minecraft.version>26.3</minecraft.version>
    </properties>
    <modules>
        <module>API</module>
        <module>v26.3</module>
        <module>v1.21.11</module>
        <module>Plugin</module>
    </modules>
    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>3.15.0</version>
            </plugin>
        </plugins>
    </build>
    <repositories>
        <repository>
            <id>spigotmc-public</id>
            <url>https://hub.spigotmc.org/nexus/content/groups/public/</url>
            <snapshots><enabled>true</enabled><updatePolicy>never</updatePolicy></snapshots>
        </repository>
        <repository>
            <id>minecraft-libraries</id>
            <url>https://libraries.minecraft.net/</url>
        </repository>
    </repositories>
    <profiles>
        <profile>
            <id>spigot-1.21.11</id>
            <properties>
                <spigot.version>${spigot.1.21.11.version}</spigot.version>
                <spigot.classifier>remapped-mojang</spigot.classifier>
                <minecraft.version>1.21.11</minecraft.version>
            </properties>
        </profile>
    </profiles>
</project>